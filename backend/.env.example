# Copy to backend/.env and fill in. The real .env is gitignored and must never
# be committed.

PORT=5000

# MongoDB Atlas connection string for this project's database.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/MatchA?retryWrites=true&w=majority

# Signs and verifies session tokens. Use a long random value, unique per
# environment; anyone holding it can mint a valid administrator session.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Credentials created by `npm run seed:users` for local demos and marking.
# Choose your own; these are never read by the running server.
SEED_ADMIN_EMAIL=admin@matcha.vip
SEED_ADMIN_PASSWORD=
SEED_MEMBER_EMAIL=member@matcha.vip
SEED_MEMBER_PASSWORD=
